---
import Base from '@/layouts/Base.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import VerdictJauge from '@/components/VerdictJauge.astro';
import { AFFIRMATIONS_ACTIVES, affirmationsOrdonnees, THEMES } from '@/lib/data';
import { breadcrumbJsonLd } from '@/lib/seo';

// Sans fiche publiée, la page existe mais n'est liée de nulle part (navigation, pied de
// page, sitemap et pages de thème sont conditionnés à AFFIRMATIONS_ACTIVES).
const fiches = affirmationsOrdonnees();
// Regroupées par thème, dans l'ordre des thèmes : un ordre mécanique, jamais éditorial.
const parTheme = THEMES
    .map((t) => ({ theme: t, fiches: fiches.filter((f) => f.theme === t.slug) }))
    .filter((g) => g.fiches.length);
---

<Base
    title="Ce qu'on entend : ce que disent les chiffres | Objectif 2027"
    description="Des affirmations entendues dans le débat public, confrontées aux données publiques. Le verdict ne porte que sur ce qui se mesure ; la part de jugement vous revient."
    jsonld={breadcrumbJsonLd([{ label: "Ce qu'on entend" }])}>

    <Breadcrumb items={[{ label: "Ce qu'on entend" }]} />
    <h1 class="text-2xl font-bold">Ce qu'on entend</h1>
    <div class="mt-2 max-w-3xl space-y-2" style="color: var(--fg-muted)">
        <p>
            Des affirmations entendues dans le débat public, confrontées aux données publiques.
            Une fiche peut conclure que l'affirmation est vraie : nous partons de ce qui se dit,
            sans présumer du résultat.
        </p>
        <p>
            Le verdict ne porte que sur ce qui se mesure — combien, comment ça évolue, comment la
            France se situe parmi ses voisins. Ce qui est « trop » relève d'un choix politique :
            cette part-là vous revient.
        </p>
    </div>
    <p class="mt-2 text-sm">
        <a href="/methodologie/#ce-qu-on-entend" class="text-brand-600 hover:underline">Comment nous vérifions →</a>
    </p>

    {!AFFIRMATIONS_ACTIVES && (
        <p class="mt-6">Aucune fiche publiée pour l'instant.</p>
    )}

    {parTheme.map(({ theme, fiches }) => (
        <section class="mt-8" aria-labelledby={`theme-${theme.slug}`}>
            <h2 id={`theme-${theme.slug}`} class="text-lg font-semibold">
                <a href={`/themes/${theme.slug}/`} class="hover:text-brand-600">{theme.nom}</a>
            </h2>
            <ul class="mt-3 grid gap-3 md:grid-cols-2">
                {fiches.map((f) => (
                    <li class="carte rounded-card border p-4" style="border-color: var(--border)">
                        <h3 class="font-semibold text-base leading-snug">
                            <a class="lien-etendu" href={`/ce-qu-on-entend/${f.slug}/`}>« {f.enonce} »</a>
                        </h3>
                        <div class="mt-3 space-y-2">
                            {f.verdicts.map((v) => <VerdictJauge verdict={v.verdict} portee={v.portee} compact />)}
                        </div>
                        {f.part_de_valeur && (
                            <p class="mt-2 text-xs" style="color: var(--fg-muted)">Contient un jugement que les chiffres ne tranchent pas.</p>
                        )}
                        {f.resume && <p class="mt-2 text-sm" style="color: var(--fg-muted)">{f.resume}</p>}
                    </li>
                ))}
            </ul>
        </section>
    ))}
</Base>

<style>
    .carte { position: relative; transition: border-color 0.15s; }
    .carte:hover, .carte:focus-within { border-color: var(--graphe-fr) !important; }
    .lien-etendu { color: inherit; text-decoration: none; }
    .lien-etendu::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
    .lien-etendu:focus-visible { outline: none; }
    .carte:focus-within { outline: 2px solid var(--graphe-fr); outline-offset: 2px; }
</style>
