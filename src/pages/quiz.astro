---
import Base from '@/layouts/Base.astro';
import Quiz from '@/islands/Quiz.vue';
import { quizParTheme } from '@/lib/data';

/*
 * Seules les questions publiées traversent. L'ancienne page sérialisait dans son HTML
 * `mesures_par_theme` complet de TOUS les candidats — arguments et sources compris —
 * pour n'en afficher qu'une poignée.
 */
const themes = quizParTheme();
---

<Base
    title="Quiz — Objectif 2027"
    description="Situez-vous sur les positions réellement défendues par les candidats. Aucune réponse n'est envoyée ni conservée.">
    <h1 class="text-2xl font-bold py-4">Où vous situez-vous&nbsp;?</h1>
    <p class="text-sm mb-4" style="color: var(--fg-muted)">
        Choisissez vos thèmes, puis les positions qui vous parlent. Nous ne calculons
        aucun score&nbsp;: à la fin, vous verrez ce que vous avez retenu et quels candidats
        le défendent. La méthode est détaillée sur la page
        <a href="/methodologie/" class="text-brand-600 hover:underline">Méthodologie</a>.
    </p>
    <Quiz client:load themes={themes} />
    <noscript>
        <p class="mt-4 text-sm rounded-card border p-4" style="border-color: var(--border)">
            Le quiz nécessite JavaScript (et s'exécute uniquement chez vous, sans rien envoyer).
            Les positions des candidats restent consultables sur les pages
            <a href="/candidats/" class="text-brand-600 hover:underline">Candidats</a> et
            <a href="/themes/" class="text-brand-600 hover:underline">Thèmes</a>.
        </p>
    </noscript>
</Base>
