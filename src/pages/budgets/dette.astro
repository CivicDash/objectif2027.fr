---
/**
 * La dette publique, d'où elle vient : trajectoire depuis 2002, hausse par présidence, part des
 * intérêts et des déficits, recettes et dépenses, impôts, aides aux entreprises, crises.
 *
 * Règles, celles de la section Budgets :
 *  - chaque chiffre avec sa source ; un chiffre que nous calculons est marqué « calcul » et sa
 *    méthode est écrite en bas de page ;
 *  - aucun responsable désigné, aucune bonne politique : les mêmes chiffres servent à tous ;
 *  - aucune couleur de parti : les présidences sont des bandes grises ;
 *  - aucun sigle technique sans explication : glossaire en bas de page.
 * Données : src/editorial/dette.json, produit par Visualisations/dette/construire.py.
 */
import Base from '@/layouts/Base.astro';
import AnchorNav from '@/components/AnchorNav.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Glossaire from '@/components/budget/Glossaire.astro';
import GrapheAnnees from '@/components/dette/GrapheAnnees.astro';
import D from '@/editorial/dette.json';
import { dateFr, nombreFr } from '@/lib/format';
import { breadcrumbJsonLd } from '@/lib/seo';

const F = D as any;
const md = (v: number, dec = 0) => `${nombreFr(v, dec)} milliards d'euros`;
const pct = (v: number) => `${nombreFr(v, 1)} %`;
const trimestre = (t: string) => `fin ${({ 1: 'mars', 2: 'juin', 3: 'septembre', 4: 'décembre' } as Record<string, string>)[t.slice(-1)]} ${t.slice(0, 4)}`;

const traj = D.trajectoire;
const premier = traj[0];
const dernier = traj[traj.length - 1];
const macron = D.presidences[2];
const C = D.cumuls;

// Présidences en années décimales (16 mai 2007 ≈ 2007,37), pour les bandes des graphiques.
const decimale = (iso: string | null) => {
    if (!iso) return dernier.annee + 1;
    const d = new Date(iso);
    return d.getUTCFullYear() + (d.getUTCMonth() * 30.4 + d.getUTCDate()) / 365;
};
const bandes = D.presidences.map((p) => ({ nom: p.nom, de: decimale(p.debut), a: decimale(p.fin) }));
const crises = D.crises;

const serieDette = [{ cle: 'dette', nom: 'Dette', couleur: 'c1' as const, valeurs: traj.map((t) => ({ annee: t.annee, valeur: t.dette_md, provisoire: t.provisoire })) }];
const serieRatio = [{ cle: 'ratio', nom: 'Dette', couleur: 'c1' as const, valeurs: traj.map((t) => ({ annee: t.annee, valeur: t.dette_pib, provisoire: t.provisoire })) }];
const seriesDeficit = [
    { cle: 'primaire', nom: 'Déficit hors intérêts', couleur: 'c1' as const, valeurs: D.deficits.map((d) => ({ annee: d.annee, valeur: d.primaire })) },
    { cle: 'interets', nom: 'Intérêts de la dette', couleur: 'c2' as const, valeurs: D.deficits.map((d) => ({ annee: d.annee, valeur: d.interets })) },
];
const seriesRD = [
    { cle: 'depenses', nom: 'Dépenses', couleur: 'c2' as const, valeurs: D.recettes_depenses.map((r) => ({ annee: r.annee, valeur: r.depenses })) },
    { cle: 'recettes', nom: 'Recettes', couleur: 'c1' as const, valeurs: D.recettes_depenses.map((r) => ({ annee: r.annee, valeur: r.recettes })) },
];
const serieInterets = [{ cle: 'interets', nom: 'Intérêts', couleur: 'c2' as const, valeurs: D.interets.map((i) => ({ annee: i.annee, valeur: i.md })) }];

const rd = (a: number) => D.recettes_depenses.find((r) => r.annee === a)!;
const r2017 = rd(2017), rFin = rd(dernier.annee), r2019 = rd(2019);
const def = (a: number) => D.deficits.find((d) => d.annee === a)!;
const int = (a: number) => D.interets.find((i) => i.annee === a)!;

// Hausse par présidence : une échelle commune pour les trois barres.
const maxHausse = Math.max(...D.presidences.map((p) => p.hausse));

// Cumul de la hausse depuis 2018 : intérêts, déficit hors intérêts, trésorerie.
const parts = [
    { cle: 'interets', nom: 'Intérêts de la dette', valeur: C.macron.interets, couleur: 'c2' },
    { cle: 'primaire', nom: 'Déficit hors intérêts', valeur: C.macron.primaire, couleur: 'c1' },
    { cle: 'ajustements', nom: 'Trésorerie et ajustements', valeur: C.macron.ajustements, couleur: 'c3' },
];

// Dépenses par fonction : une échelle commune autour de zéro.
const fonctions = D.fonctions.lignes;
const maxVol = Math.max(...fonctions.map((f) => Math.abs(f.volume_pct)));
const xV = (v: number) => 50 + (v / maxVol) * 48;
const totalF = fonctions.find((f) => f.code === 'TOTAL')!;

const seriePO = F.prelevements ? [{ cle: 'po', nom: 'Prélèvements', couleur: 'c1' as const, valeurs: F.prelevements.valeurs }] : [];
const po = (a: number) => F.prelevements?.valeurs.find((v: any) => v.annee === a)?.valeur ?? 0;

// Classement des mesures durables depuis 2007, du plus coûteux au moins coûteux.
const classement = F.classement ? [...F.classement.mesures].sort((a: any, b: any) => b.cout - a.cout) : [];
const maxCl = classement.length ? classement[0].cout : 1;

// Mesures fiscales : une échelle commune autour de zéro, en milliards d'euros par an.
const lignesMes = F.mesures ? F.mesures.periodes.flatMap((p: any) => p.lignes).filter((l: any) => l.effet != null) : [];
const maxMes = lignesMes.length ? Math.ceil(Math.max(...lignesMes.map((l: any) => Math.abs(l.effet))) / 5) * 5 : 1;
const xM = (v: number) => 50 + (v / maxMes) * 48;

const titre = "La dette publique, d'où elle vient";
const ancres = [
    { id: 't-traj', label: 'Depuis 2002' },
    { id: 't-pres', label: 'Par présidence' },
    { id: 't-orig', label: "D'où elle vient" },
    { id: 't-crises', label: 'Les crises', si: F.couts_crises },
    { id: 't-classement', label: 'Les mesures', si: F.classement },
    { id: 't-rd', label: 'Recettes et dépenses' },
    { id: 't-mes', label: 'Impôts', si: F.mesures },
    { id: 't-aides', label: 'Aides aux entreprises', si: F.aides },
    { id: 't-dep', label: 'Dépenses' },
    { id: 't-int', label: 'Intérêts' },
    { id: 't-riche', label: 'Patrimoine', si: F.richesse },
    { id: 't-cand', label: 'Les candidats' },
].filter((a) => !('si' in a) || a.si).map(({ id, label }) => ({ id, label }));
const lienEurostat = D.eurostat.lien;
---

<Base
    title="Dette publique : d'où viennent les 1 300 milliards de hausse depuis 2017 ? | Objectif 2027"
    description="La dette publique française depuis 2002, présidence par présidence : déficits, intérêts, crises, recettes et dépenses, baisses et hausses d'impôts. Les chiffres officiels, sourcés, sans parti pris."
    ogType="article"
    jsonld={breadcrumbJsonLd([{ label: 'Budgets', href: '/budgets/' }, { label: titre }])}>
    <Breadcrumb items={[{ label: 'Budgets', href: '/budgets/' }, { label: titre }]} />

    <div class="dette">
        <header class="prose">
            <h1 class="text-2xl font-bold">{titre}</h1>
            <p>La dette publique a augmenté de {nombreFr(macron.hausse, 0)} milliards d'euros entre {trimestre(macron.t0)} et {trimestre(macron.t1)}. Cette page rassemble les chiffres officiels pour comprendre comment : les déficits, les crises, les intérêts, les impôts, les dépenses.</p>
            <p>Chaque chiffre renvoie à sa source. Nous ne désignons ni responsable ni bonne politique : ces chiffres sont les mêmes pour tous les candidats, et chacun peut s'en servir pour juger leurs propositions.</p>
            <p>La dette publique, c'est celle de l'État, de la Sécurité sociale et des collectivités locales réunis. Les mots techniques sont expliqués dans le <a href="#glossaire">glossaire</a>.</p>
            {F.verifie_au && <p class="etat"><span>Chiffres vérifiés au {dateFr(F.verifie_au)}</span></p>}
        </header>

        <AnchorNav items={ancres} />

        <section aria-labelledby="t-cles" class="cles">
            <h2 id="t-cles" class="sr-only">Chiffres clés</h2>
            <div class="tuile">
                <strong>{nombreFr(macron.dette_fin, 0)} Md€</strong>
                <span>Dette publique {trimestre(macron.t1)}, soit {pct(macron.pib_fin)} du PIB</span>
            </div>
            <div class="tuile">
                <strong>+{nombreFr(macron.hausse, 0)} Md€</strong>
                <span>Depuis {trimestre(macron.t0)} ({nombreFr(macron.dette_debut, 0)} milliards)</span>
            </div>
            <div class="tuile">
                <strong>{nombreFr(int(dernier.annee).md, 1)} Md€</strong>
                <span>Intérêts payés en {dernier.annee}, contre {nombreFr(int(2017).md, 1)} milliards en 2017</span>
            </div>
            <div class="tuile">
                <strong>{pct(def(dernier.annee).deficit_pib)} du PIB</strong>
                <span>Déficit public en {dernier.annee}, soit {md(def(dernier.annee).deficit, 1)}</span>
            </div>
        </section>

        <section aria-labelledby="t-traj">
            <div class="prose">
                <h2 id="t-traj" class="text-lg font-semibold">La dette depuis {premier.annee}</h2>
                <p>La dette a augmenté sous chacune des trois dernières présidences, plus vite pendant les crises. En euros, elle a été multipliée par {nombreFr(dernier.dette_md / premier.dette_md, 1)} depuis {premier.annee}. Rapportée au PIB, la richesse produite en un an, elle est passée de {pct(premier.dette_pib)} à {pct(dernier.dette_pib)}.</p>
            </div>
            <figure class="figure" aria-labelledby="f-traj">
                <figcaption id="f-traj"><strong>Dette publique en fin d'année</strong><span>En milliards d'euros courants</span></figcaption>
                <GrapheAnnees type="aire" series={serieDette} bandes={bandes} crises={crises} unite="Md€" finAnnee compact
                              etiquette={`Dette publique de fin ${premier.annee} à fin ${dernier.annee}, en milliards d'euros : de ${nombreFr(premier.dette_md, 0)} à ${nombreFr(dernier.dette_md, 0)}.`} />
                <GrapheAnnees type="aire" series={serieDette} bandes={bandes} crises={crises} unite="Md€" finAnnee
                              etiquette={`Dette publique de fin ${premier.annee} à fin ${dernier.annee}, en milliards d'euros : de ${nombreFr(premier.dette_md, 0)} à ${nombreFr(dernier.dette_md, 0)}.`} />
                <figcaption><strong>La même dette rapportée au PIB</strong><span>En % du PIB</span></figcaption>
                <GrapheAnnees type="courbes" series={serieRatio} bandes={bandes} crises={crises} unite="% du PIB" decimales={1} finAnnee compact
                              etiquette={`Dette publique en % du PIB : ${pct(premier.dette_pib)} fin ${premier.annee}, ${pct(dernier.dette_pib)} fin ${dernier.annee}.`} />
                <GrapheAnnees type="courbes" series={serieRatio} bandes={bandes} crises={crises} unite="% du PIB" decimales={1} finAnnee
                              etiquette={`Dette publique en % du PIB : ${pct(premier.dette_pib)} fin ${premier.annee}, ${pct(dernier.dette_pib)} fin ${dernier.annee}.`} />
                <p class="legende">Bandes grises : les présidences. Traits sous la courbe : crise financière ({crises[0].de}-{crises[0].a}), crise sanitaire ({crises[1].de}-{crises[1].a}), flambée des prix de l'énergie ({crises[2].de}-{crises[2].a}). Point creux : chiffre provisoire. Source : <a href={lienEurostat} target="_blank" rel="noopener">Eurostat</a>, comptes des administrations publiques, mis à jour le {dateFr(D.eurostat.maj)}.</p>
                <details>
                    <summary>Voir les chiffres en tableau</summary>
                    <div class="tableau-ext">
                        <table>
                            <thead><tr><th>Fin d'année</th><th>Dette (milliards d'euros)</th><th>En % du PIB</th></tr></thead>
                            <tbody>{traj.map((t) => <tr><td>{t.annee}</td><td>{nombreFr(t.dette_md, 0)}{t.provisoire && ' (provisoire)'}</td><td>{pct(t.dette_pib)}</td></tr>)}</tbody>
                        </table>
                    </div>
                </details>
            </figure>
        </section>

        <section aria-labelledby="t-pres">
            <div class="prose">
                <h2 id="t-pres" class="text-lg font-semibold">Présidence par présidence</h2>
                <p>La dette n'étant publiée qu'en fin de trimestre, chaque période va de la fin juin qui suit une investiture à la fin juin qui suit la suivante.</p>
            </div>
            <figure class="figure" aria-labelledby="f-pres">
                <figcaption id="f-pres"><strong>Hausse de la dette publique</strong><span>En milliards d'euros courants</span></figcaption>
                <div class="pres">
                    {D.presidences.map((p) => (
                        <div class="pres-ligne">
                            <div class="pres-nom"><strong>{p.nom}</strong><span class="muet petit">{trimestre(p.t0)} → {trimestre(p.t1)}</span></div>
                            <div class="track"><span class="fill c1" style={`width:${(p.hausse / maxHausse) * 100}%`}></span></div>
                            <div class="pres-val"><strong>+{nombreFr(p.hausse, 0)}</strong><span class="muet petit">{nombreFr(p.par_an, 0)} par an</span></div>
                        </div>
                    ))}
                </div>
                <div class="tableau-ext">
                    <table>
                        <thead><tr><th>Présidence</th><th>Dette au début</th><th>Dette à la fin</th><th>Hausse</th><th>Par an</th><th>En % du PIB</th></tr></thead>
                        <tbody>
                            {D.presidences.map((p) => (
                                <tr>
                                    <td>{p.nom}<br /><span class="muet petit">{trimestre(p.t0)} → {trimestre(p.t1)}</span></td>
                                    <td>{nombreFr(p.dette_debut, 0)} Md€</td>
                                    <td>{nombreFr(p.dette_fin, 0)} Md€</td>
                                    <td>+{nombreFr(p.hausse, 0)} Md€</td>
                                    <td>{nombreFr(p.par_an, 0)} Md€</td>
                                    <td>{pct(p.pib_debut)} → {pct(p.pib_fin)}<br /><span class="muet petit">{p.pib_fin - p.pib_debut >= 0 ? '+' : ''}{nombreFr(p.pib_fin - p.pib_debut, 1)} points</span></td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
                <p class="legende">Source : <a href={lienEurostat} target="_blank" rel="noopener">Eurostat</a>, dette trimestrielle des administrations publiques. Hausses et moyennes annuelles : calcul.</p>
            </figure>
            <div class="prose avertir">
                <h3 class="font-semibold">Pour comparer honnêtement</h3>
                <ul>
                    <li>Les durées diffèrent : cinq ans pour les deux premières présidences, {nombreFr(macron.annees, 0)} ans (deux mandats) pour la troisième. D'où la colonne « par an ».</li>
                    <li>Les crises ne tombent pas au même moment : la crise financière de 2008-2009 sous Nicolas Sarkozy, la crise sanitaire et la flambée des prix de l'énergie sous Emmanuel Macron. Leur poids est détaillé plus bas.</li>
                    <li>Les montants sont en euros courants : avec l'inflation, un milliard de 2007 ne vaut pas un milliard de 2026. Rapportée au PIB, qui intègre la hausse des prix, la hausse est de {nombreFr(D.presidences[0].pib_fin - D.presidences[0].pib_debut, 0)} points, {nombreFr(D.presidences[1].pib_fin - D.presidences[1].pib_debut, 0)} points, puis {nombreFr(macron.pib_fin - macron.pib_debut, 0)} points.</li>
                    <li>Le premier budget d'un président s'applique à l'année qui suit son élection : une partie de la première année relève encore du budget voté sous son prédécesseur.</li>
                </ul>
            </div>
        </section>

        <section aria-labelledby="t-orig">
            <div class="prose">
                <h2 id="t-orig" class="text-lg font-semibold">D'où viennent les {nombreFr(C.macron.hausse_dette, 0)} milliards de {C.macron.de} à {C.macron.a}</h2>
                <p>Chaque année, la dette augmente du déficit : ce qui manque pour que les recettes couvrent les dépenses, y compris les intérêts des emprunts passés. S'y ajoutent des mouvements de trésorerie, quand l'État garde plus ou moins d'argent en caisse.</p>
            </div>
            <figure class="figure" aria-labelledby="f-orig">
                <figcaption id="f-orig"><strong>Hausse cumulée de la dette, fin {C.macron.de - 1} à fin {C.macron.a}</strong><span>En milliards d'euros courants</span></figcaption>
                <div class="empile" role="img" aria-label={parts.map((p) => `${p.nom} : ${nombreFr(p.valeur, 0)} milliards`).join(', ')}>
                    {parts.map((p) => <span class:list={['seg', p.couleur]} style={`flex:${p.valeur}`} title={`${p.nom} : ${nombreFr(p.valeur, 0)} milliards d'euros`}></span>)}
                </div>
                <ul class="legende-empile">
                    {parts.map((p) => <li><span class:list={['pastille', p.couleur]} aria-hidden="true"></span>{p.nom} <strong>{nombreFr(p.valeur, 0)}</strong> <span class="muet">({nombreFr((100 * p.valeur) / C.macron.hausse_dette, 0)} %)</span></li>)}
                </ul>
                <p class="legende">Source : <a href={lienEurostat} target="_blank" rel="noopener">Eurostat</a>, déficit, intérêts versés et dette des administrations publiques. Sommes et parts : calcul.</p>
            </figure>
            <div class="prose">
                <ul>
                    <li><strong>Pendant les crises, de {C.crises.de} à {C.crises.a}</strong> : +{nombreFr(C.crises.hausse_dette, 0)} milliards, dont {nombreFr(C.crises.primaire, 0)} de déficit hors intérêts.</li>
                    <li><strong>Après les crises, de {C.apres_crises.de} à {C.apres_crises.a}</strong> : +{nombreFr(C.apres_crises.hausse_dette, 0)} milliards. Le déficit hors intérêts n'est pas revenu à son niveau d'avant : {nombreFr(def(2023).primaire, 0)}, {nombreFr(def(2024).primaire, 0)} puis {nombreFr(def(2025).primaire, 0)} milliards par an, contre {nombreFr(def(2018).primaire, 0)} et {nombreFr(def(2019).primaire, 0)} milliards en 2018 et 2019.</li>
                    <li><strong>Les intérêts</strong> représentent {nombreFr(C.macron.interets, 0)} milliards sur la période : c'est le coût des dettes accumulées auparavant, sous toutes les présidences.</li>
                </ul>
            </div>
            <figure class="figure" aria-labelledby="f-def">
                <figcaption id="f-def"><strong>Le déficit public chaque année, intérêts à part</strong><span>En milliards d'euros courants</span></figcaption>
                <GrapheAnnees type="barres" series={seriesDeficit} bandes={bandes} unite="Md€" compact
                              etiquette={`Déficit public par année, de ${D.deficits[0].annee} à ${dernier.annee}, décomposé en déficit hors intérêts et intérêts de la dette.`} />
                <GrapheAnnees type="barres" series={seriesDeficit} bandes={bandes} unite="Md€"
                              etiquette={`Déficit public par année, de ${D.deficits[0].annee} à ${dernier.annee}, décomposé en déficit hors intérêts et intérêts de la dette.`} />
                <ul class="legende-empile">{seriesDeficit.map((s) => <li><span class:list={['pastille', s.couleur]} aria-hidden="true"></span>{s.nom}</li>)}</ul>
                <p class="legende">Le déficit hors intérêts est appelé « déficit primaire ». Source : <a href={lienEurostat} target="_blank" rel="noopener">Eurostat</a> ; déficit hors intérêts : calcul (déficit moins intérêts versés).</p>
                <details>
                    <summary>Voir les chiffres en tableau</summary>
                    <div class="tableau-ext">
                        <table>
                            <thead><tr><th>Année</th><th>Hausse de la dette</th><th>Déficit</th><th>dont intérêts</th><th>dont hors intérêts</th><th>Trésorerie et ajustements</th></tr></thead>
                            <tbody>{D.deficits.map((d) => <tr><td>{d.annee}</td><td>{nombreFr(d.hausse_dette, 1)}</td><td>{nombreFr(d.deficit, 1)} <span class="muet">({pct(d.deficit_pib)} du PIB)</span></td><td>{nombreFr(d.interets, 1)}</td><td>{nombreFr(d.primaire, 1)}</td><td>{nombreFr(d.ajustements, 1)}</td></tr>)}</tbody>
                        </table>
                        <p class="petit muet">En milliards d'euros courants.</p>
                    </div>
                </details>
            </figure>
        </section>

        {F.couts_crises && (
            <section aria-labelledby="t-crises">
                <div class="prose">
                    <h2 id="t-crises" class="text-lg font-semibold">Ce qu'ont coûté les crises</h2>
                </div>
                <div class="cartes">
                    {[F.couts_crises.financiere, F.couts_crises.sanitaire, F.couts_crises.energie].filter(Boolean).map((c: any) => (
                        <article class="carte">
                            <h3>{c.titre}</h3>
                            <strong class="carte-chiffre">{c.chiffre}</strong>
                            <p>{c.texte}</p>
                            <p class="source"><a href={c.lien} target="_blank" rel="noopener">{c.source}</a></p>
                        </article>
                    ))}
                </div>
                <div class="prose">
                    <p>{F.couts_crises.parts_intro}</p>
                    <ul>
                        {F.couts_crises.parts.map((x: any) => <li><strong>{x.qui}.</strong> {x.texte} <a href={x.lien} target="_blank" rel="noopener">source ↗</a></li>)}
                    </ul>
                </div>
            </section>
        )}

        {F.classement && (
            <section aria-labelledby="t-classement">
                <div class="prose">
                    <h2 id="t-classement" class="text-lg font-semibold">Les mesures durables qui pèsent le plus depuis 2007</h2>
                    <p>Au-delà des crises, certaines décisions coûtent chaque année : des baisses d'impôts ou de cotisations, et des dépenses nouvelles. Voici les principales depuis 2007, rangées selon leur coût annuel une fois pleinement en place, tel que l'organisme cité le chiffre.</p>
                    <p>Ces montants ne s'additionnent pas : périmètres et années de référence diffèrent, et certaines mesures ont été financées en partie par d'autres hausses. Une mesure coûteuse n'est pas pour autant inutile : ses effets sur l'emploi, l'investissement ou le pouvoir d'achat se discutent.</p>
                </div>
                <figure class="figure" aria-labelledby="f-classement">
                    <figcaption id="f-classement"><strong>Coût annuel des principales mesures durables depuis 2007</strong><span>En milliards d'euros par an</span></figcaption>
                    <ul class="legende-empile">
                        <li><span class="pastille c2" aria-hidden="true"></span>Baisse d'impôts ou de cotisations : moins de recettes</li>
                        <li><span class="pastille c4" aria-hidden="true"></span>Dépense nouvelle durable</li>
                    </ul>
                    <ol class="classement">
                        {classement.map((m: any) => (
                            <li class="cl">
                                <div class="cl-lib">
                                    <span class="cl-nom">{m.mesure}</span>
                                    <span class="muet petit">{m.qui} · {m.annee}{m.note && ` · ${m.note}`} · <a href={m.lien} target="_blank" rel="noopener">{m.source}</a></span>
                                </div>
                                <div class="track"><span class:list={['fill', 'pos', m.type === 'recettes' ? 'c2' : 'c4']} style={`left:0;width:${(m.cout / maxCl) * 100}%`}
                                     title={`${m.mesure} : ${m.texte} milliards d'euros par an`}></span></div>
                                <div class="cl-val">{m.texte}</div>
                            </li>
                        ))}
                    </ol>
                    <p class="petit muet">Également, sous {nombreFr(classement[classement.length - 1].cout, 1)} milliards par an : {F.classement.egalement_liste.map((x: any, i: number) => <>{i > 0 && ' ; '}<a href={x.lien} target="_blank" rel="noopener">{x.texte}</a></>)}.</p>
                    <details>
                        <summary>Voir les chiffres en tableau</summary>
                        <div class="tableau-ext">
                            <table>
                                <thead><tr><th>Rang</th><th>Mesure</th><th>Présidence</th><th>Année</th><th>Coût annuel</th><th>Source</th></tr></thead>
                                <tbody>{classement.map((m: any, i: number) => <tr><td>{i + 1}</td><td>{m.mesure}{m.note && <><br /><span class="muet petit">{m.note}</span></>}</td><td>{m.qui}</td><td>{m.annee}</td><td>{m.texte} Md€</td><td><a href={m.lien} target="_blank" rel="noopener">{m.source}</a></td></tr>)}</tbody>
                            </table>
                        </div>
                    </details>
                </figure>
                <div class="prose">
                    <h3 class="font-semibold">En sens inverse : hausses d'impôts et économies</h3>
                    <ul>{F.classement.hausses.map((h: any) => <li>{h.texte}. <a href={h.lien} target="_blank" rel="noopener">{h.source}</a></li>)}</ul>
                    <p>{F.classement.perspective} <a href={F.classement.lien_perspective} target="_blank" rel="noopener">{F.classement.source_perspective}</a></p>
                </div>
            </section>
        )}

        <section aria-labelledby="t-rd">
            <div class="prose">
                <h2 id="t-rd" class="text-lg font-semibold">Recettes et dépenses</h2>
                <p>Le déficit est l'écart entre les deux courbes ci-dessous. Rapportées au PIB, les dépenses publiques sont revenues après le pic de 2020 à peu près à leur niveau de 2017 ({pct(rFin.depenses)} en {dernier.annee} contre {pct(r2017.depenses)}), mais au-dessus de 2019 ({pct(r2019.depenses)}). Les recettes sont plus basses qu'en 2017 ({pct(rFin.recettes)} contre {pct(r2017.recettes)}).</p>
                <p>Rapportée au PIB, une dépense peut baisser alors qu'elle augmente en euros : il suffit que la richesse produite augmente plus vite.</p>
            </div>
            <figure class="figure" aria-labelledby="f-rd">
                <figcaption id="f-rd"><strong>Recettes et dépenses publiques</strong><span>En % du PIB</span></figcaption>
                <GrapheAnnees type="courbes" series={seriesRD} bandes={bandes} crises={crises} unite="% du PIB" decimales={1} yMin={45} compact
                              etiquette={`Recettes et dépenses publiques en % du PIB. En ${dernier.annee} : dépenses ${pct(rFin.depenses)}, recettes ${pct(rFin.recettes)}.`} />
                <GrapheAnnees type="courbes" series={seriesRD} bandes={bandes} crises={crises} unite="% du PIB" decimales={1} yMin={45}
                              etiquette={`Recettes et dépenses publiques en % du PIB. En ${dernier.annee} : dépenses ${pct(rFin.depenses)}, recettes ${pct(rFin.recettes)}.`} />
                <p class="legende">Axe vertical à partir de 45 %. Source : <a href={lienEurostat} target="_blank" rel="noopener">Eurostat</a>, recettes et dépenses totales des administrations publiques.</p>
                {F.cice_ecriture && <p class="note">{F.cice_ecriture.texte} <a href={F.cice_ecriture.lien} target="_blank" rel="noopener">{F.cice_ecriture.source}</a></p>}
                <details>
                    <summary>Voir les chiffres en tableau</summary>
                    <div class="tableau-ext">
                        <table>
                            <thead><tr><th>Année</th><th>Recettes</th><th>Dépenses</th><th>dont intérêts</th></tr></thead>
                            <tbody>{D.recettes_depenses.map((r) => <tr><td>{r.annee}</td><td>{pct(r.recettes)}</td><td>{pct(r.depenses)}</td><td>{pct(r.interets)}</td></tr>)}</tbody>
                        </table>
                        <p class="petit muet">En % du PIB.</p>
                    </div>
                </details>
            </figure>
            {F.deux_lectures && (
                <div class="lectures">
                    <p class="prose-p">{F.deux_lectures.intro}</p>
                    <div class="cartes">
                        {F.deux_lectures.lectures.map((l: any) => (
                            <article class="carte">
                                <h3>{l.titre}</h3>
                                <p>{l.texte}</p>
