                    </div>
                    <p class="prose-p"><strong>{F.deux_lectures.conclusion}</strong></p>
                </div>
            )}
            {F.derapage && (
                <div class="prose">
                    <h3 class="font-semibold">Les prévisions manquées de 2023 et 2024</h3>
                    <p>{F.derapage.texte} <a href={F.derapage.lien} target="_blank" rel="noopener">{F.derapage.source}</a></p>
                </div>
            )}
        </section>

        {F.mesures && (
            <section aria-labelledby="t-mes">
                <div class="prose">
                    <h2 id="t-mes" class="text-lg font-semibold">Les baisses et les hausses d'impôts depuis 2012</h2>
                    <p>{F.mesures.intro[0]}</p>
                </div>
                {F.prelevements && (
                    <figure class="figure" aria-labelledby="f-po">
                        <figcaption id="f-po"><strong>Taux de prélèvements obligatoires</strong><span>Impôts et cotisations sociales, en % du PIB</span></figcaption>
                        <GrapheAnnees type="courbes" series={seriePO} bandes={bandes} unite="% du PIB" decimales={1} yMin={40} compact
                                      etiquette={`Taux de prélèvements obligatoires : ${pct(po(2011))} en 2011, ${pct(po(2017))} en 2017, ${pct(po(2024))} en 2024, ${pct(po(2025))} en 2025.`} />
                        <GrapheAnnees type="courbes" series={seriePO} bandes={bandes} unite="% du PIB" decimales={1} yMin={40}
                                      etiquette={`Taux de prélèvements obligatoires : ${pct(po(2011))} en 2011, ${pct(po(2017))} en 2017, ${pct(po(2024))} en 2024, ${pct(po(2025))} en 2025.`} />
                        <p class="legende">Axe vertical à partir de 40 %. Point creux : chiffre provisoire. Source : <a href={F.prelevements.lien} target="_blank" rel="noopener">{F.prelevements.source}</a>.</p>
                    </figure>
                )}
                <div class="prose">{F.mesures.intro.slice(1).map((t: string) => <p>{t}</p>)}</div>
                <figure class="figure" aria-labelledby="f-mes">
                    <figcaption id="f-mes"><strong>Effet des principales mesures sur les recettes publiques</strong><span>En milliards d'euros par an, une fois la mesure pleinement en place</span></figcaption>
                    <ul class="legende-empile">
                        <li><span class="pastille c2" aria-hidden="true"></span>Baisse d'impôts ou de cotisations : moins de recettes</li>
                        <li><span class="pastille c1" aria-hidden="true"></span>Hausse : plus de recettes</li>
                    </ul>
                    {F.mesures.periodes.map((per: any) => (
                        <div class="mes-periode">
                            <h3>{per.nom}</h3>
                            {per.lignes.map((l: any) => (
                                <div class="mes">
                                    <div class="mes-lib">{l.mesure} <span class="muet petit">({l.annee})</span>
                                        {l.note && <span class="mes-note">{l.note}</span>}</div>
                                    <div class="track">
                                        <span class="zero" style="left:50%"></span>
                                        {l.effet != null && <span class:list={['fill', l.effet < 0 ? 'neg c2' : 'pos c1']}
                                              style={`left:${Math.min(50, xM(l.effet))}%;width:${Math.abs(xM(l.effet) - 50)}%`}
                                              title={`${l.mesure} : ${l.texte}`}></span>}
                                    </div>
                                    <div class="mes-val">{l.texte} <a href={l.lien} target="_blank" rel="noopener">source ↗</a></div>
                                </div>
                            ))}
                        </div>
                    ))}
                    <p class="legende">Échelle commune de −{nombreFr(maxMes, 0)} à +{nombreFr(maxMes, 0)} milliards d'euros par an. Chaque montant est celui de l'organisme cité ; les périmètres et les années de référence diffèrent, c'est pourquoi la page n'en fait pas la somme.</p>
                    <details>
                        <summary>Voir les chiffres en tableau</summary>
                        <div class="tableau-ext">
                            <table>
                                <thead><tr><th>Mesure</th><th>Année</th><th>Effet annuel sur les recettes</th><th>Source</th></tr></thead>
                                <tbody>
                                    {F.mesures.periodes.flatMap((per: any) => per.lignes.map((l: any) => (
                                        <tr><td>{l.mesure}{l.note && <><br /><span class="muet petit">{l.note}</span></>}</td><td>{l.annee}</td><td>{l.texte}</td><td><a href={l.lien} target="_blank" rel="noopener">{l.source}</a></td></tr>
                                    )))}
                                </tbody>
                            </table>
                        </div>
                    </details>
                </figure>
                {F.mesures.totaux && (
                    <div class="prose">
                        <h3 class="font-semibold">Au total</h3>
                        <ul>{F.mesures.totaux.map((t: any) => <li>{t.texte} <a href={t.lien} target="_blank" rel="noopener">{t.source}</a></li>)}</ul>
                    </div>
                )}
            </section>
        )}

        {F.aides && (
            <section aria-labelledby="t-aides">
                <div class="prose">
                    <h2 id="t-aides" class="text-lg font-semibold">Les aides publiques aux entreprises</h2>
                    {F.aides.intro.map((t: string) => <p>{t}</p>)}
                </div>
                <div class="cles">
                    {F.aides.chiffres.map((c: any) => (
                        <div class="tuile">
                            <strong>{c.valeur}</strong>
                            <span>{c.texte}</span>
                            <a class="petit" href={c.lien} target="_blank" rel="noopener">{c.source}</a>
                        </div>
                    ))}
                </div>
                {F.aides.efficacite && (
                    <div class="prose">
                        <h3 class="font-semibold">Ce que l'on sait de leur efficacité</h3>
                        <ul>{F.aides.efficacite.map((e: any) => <li>{e.texte} <a href={e.lien} target="_blank" rel="noopener">{e.source}</a></li>)}</ul>
                    </div>
                )}
            </section>
        )}

        <section aria-labelledby="t-dep">
            <div class="prose">
                <h2 id="t-dep" class="text-lg font-semibold">Les dépenses ont-elles baissé ?</h2>
                <p>En euros, les dépenses publiques sont passées de {md(totalF.md_debut, 0)} en {D.fonctions.de} à {md(totalF.md_fin, 0)} en {D.fonctions.a}. Une fois retirée la hausse des prix à la consommation sur la période (+{nombreFr(D.fonctions.prix_pct, 1)} %), elles ont augmenté de {nombreFr(totalF.volume_pct, 1)} %. Certains postes ont nettement progressé, d'autres ont reculé.</p>
            </div>
            <figure class="figure" aria-labelledby="f-dep">
                <figcaption id="f-dep"><strong>Évolution des dépenses par fonction, {D.fonctions.de}-{D.fonctions.a}, hors hausse des prix</strong><span>En %, avec les montants en milliards d'euros</span></figcaption>
                <div class="fonctions">
                    {fonctions.map((f) => (
                        <div class:list={['fn', { sous: f.sous, total: f.code === 'TOTAL' }]}>
                            <div class="fn-lib">{f.libelle}<span class="muet petit"> {nombreFr(f.md_debut, 0)} → {nombreFr(f.md_fin, 0)} Md€</span></div>
                            <div class="track">
                                <span class="zero" style="left:50%"></span>
                                <span class:list={['fill', f.volume_pct >= 0 ? 'pos c1' : 'neg c2']}
                                      style={`left:${Math.min(50, xV(f.volume_pct))}%;width:${Math.abs(xV(f.volume_pct) - 50)}%`}
                                      title={`${f.libelle} : ${f.volume_pct >= 0 ? '+' : ''}${nombreFr(f.volume_pct, 1)} %`}></span>
                            </div>
                            <div class="fn-val">{f.volume_pct >= 0 ? '+' : ''}{nombreFr(f.volume_pct, 1)} %</div>
                        </div>
                    ))}
                </div>
                <p class="legende">Dépenses de l'ensemble des administrations publiques classées par fonction. Évolution hors hausse des prix : calcul, avec l'indice des prix à la consommation harmonisé. Source : <a href="https://ec.europa.eu/eurostat/databrowser/view/gov_10a_exp/default/table?lang=fr" target="_blank" rel="noopener">Eurostat</a>. Les « affaires économiques » baissent en partie par un effet d'écriture : le crédit d'impôt pour la compétitivité et l'emploi y était compté jusqu'en 2018, puis remplacé par une baisse de cotisations, comptée en moindres recettes.</p>
            </figure>
            {F.economies_definition && (
                <div class="prose"><p>{F.economies_definition.texte} <a href={F.economies_definition.lien} target="_blank" rel="noopener">{F.economies_definition.source}</a></p></div>
            )}
            {F.efforts_recents && (
                <div class="prose">
                    <h3 class="font-semibold">Depuis 2025</h3>
                    <ul>{F.efforts_recents.map((e: any) => <li>{e.texte} <a href={e.lien} target="_blank" rel="noopener">{e.source}</a></li>)}</ul>
                </div>
            )}
        </section>

        <section aria-labelledby="t-int">
            <div class="prose">
                <h2 id="t-int" class="text-lg font-semibold">Le coût des intérêts</h2>
                <p>De 2012 à 2020, les intérêts ont baissé alors que la dette augmentait, parce que les taux d'emprunt étaient très bas. Ils remontent depuis 2022 avec la hausse des taux et de l'inflation, une partie de la dette étant indexée sur les prix : {md(int(dernier.annee).md, 1)} en {dernier.annee}, contre {nombreFr(int(2020).md, 1)} en 2020.</p>
            </div>
            <figure class="figure" aria-labelledby="f-int">
                <figcaption id="f-int"><strong>Intérêts versés par les administrations publiques</strong><span>En milliards d'euros courants</span></figcaption>
                <GrapheAnnees type="barres" series={serieInterets} bandes={bandes} unite="Md€" compact
                              etiquette={`Intérêts versés de ${D.interets[0].annee} à ${dernier.annee} : ${nombreFr(int(2017).md, 1)} milliards en 2017, ${nombreFr(int(2020).md, 1)} en 2020, ${nombreFr(int(dernier.annee).md, 1)} en ${dernier.annee}.`} />
                <GrapheAnnees type="barres" series={serieInterets} bandes={bandes} unite="Md€"
                              etiquette={`Intérêts versés de ${D.interets[0].annee} à ${dernier.annee} : ${nombreFr(int(2017).md, 1)} milliards en 2017, ${nombreFr(int(2020).md, 1)} en 2020, ${nombreFr(int(dernier.annee).md, 1)} en ${dernier.annee}.`} />
                <p class="legende">Source : <a href={lienEurostat} target="_blank" rel="noopener">Eurostat</a>, intérêts versés (comptabilité nationale, ce qui diffère un peu de la « charge de la dette » du budget de l'État).</p>
                {F.interets_projection && <p class="note">{F.interets_projection.texte} <a href={F.interets_projection.lien} target="_blank" rel="noopener">{F.interets_projection.source}</a> ; <a href={F.interets_projection.lien2} target="_blank" rel="noopener">{F.interets_projection.source2}</a>.</p>}
            </figure>
            {F.detenteurs && (
                <div class="prose">
                    <h3 class="font-semibold">À qui la France doit-elle cet argent ?</h3>
                    <p>{F.detenteurs.texte} <a href={F.detenteurs.lien} target="_blank" rel="noopener">{F.detenteurs.source}</a></p>
                </div>
            )}
        </section>

        {F.richesse && (
            <section aria-labelledby="t-riche">
                <div class="prose">
                    <h2 id="t-riche" class="text-lg font-semibold">Un pays riche, un État endetté ?</h2>
                    <p>{F.richesse.intro}</p>
                </div>
                <div class="cles">
                    {F.richesse.chiffres.map((c: any) => (
                        <div class="tuile">
                            <strong>{c.valeur}</strong>
                            <span>{c.texte}</span>
                            <a class="petit" href={c.lien} target="_blank" rel="noopener">{c.source}</a>
                        </div>
                    ))}
                </div>
                <div class="prose"><ul>{F.richesse.limites.map((l: string) => <li>{l}</li>)}</ul></div>
            </section>
        )}

        <section aria-labelledby="t-cand" class="renvois">
            <h2 id="t-cand" class="text-lg font-semibold">Ce que proposent les candidats</h2>
            <ul>
                <li><a href="/budgets/">La grille des budgets des candidats</a> : déficit et dette visés, économies, recettes nouvelles, à côté des chiffres officiels.</li>
                <li><a href="/budgets/2027/">Trois budgets pour 2027</a> : le projet du gouvernement, le contre-budget du Rassemblement national et le budget de première année de La France insoumise.</li>
                <li><a href="/themes/fiscalite-budget/">Le thème Fiscalité &amp; budget</a> : toutes les propositions sur les impôts, la dette et la dépense publique, mesure par mesure.</li>
                <li>Les questions débattues, avec les faits sourcés des deux côtés : <a href="/questions/allegements-cotisations/">les allègements de cotisations patronales</a>, <a href="/questions/imposition-tres-hauts-patrimoines/">l'imposition des très hauts patrimoines</a>, <a href="/questions/taxation-des-heritages/">les droits de succession</a>, <a href="/questions/annulation-dette-bce/">l'annulation de la dette détenue par la Banque centrale européenne</a>.</li>
            </ul>
        </section>

        <section aria-labelledby="t-meth" class="methode">
            <h2 id="t-meth" class="text-lg font-semibold">Méthode</h2>
            <ul>
                <li>Les séries viennent d'Eurostat, qui publie les comptes des administrations publiques transmis par l'Insee selon les règles européennes : dette dite « de Maastricht », déficit, recettes, dépenses, intérêts versés. Dernière mise à jour utilisée : {dateFr(D.eurostat.maj)} ; les chiffres de {dernier.annee} sont provisoires.</li>
                <li>Hausse par présidence : écart entre la dette de fin juin qui suit l'investiture et celle de fin juin qui suit l'investiture suivante (ou le dernier trimestre publié, {trimestre(D.eurostat.dernier_trimestre)}).</li>
                <li>Décomposition de la hausse : la hausse de la dette d'une année est égale au déficit de cette année, plus les mouvements de trésorerie et ajustements comptables. Le déficit hors intérêts est le déficit moins les intérêts versés.</li>
                <li>Évolution hors hausse des prix : montant de la dernière année divisé par celui de {D.fonctions.de}, puis par l'évolution de l'indice des prix à la consommation harmonisé. Avec l'évolution générale des prix de l'économie (déflateur du PIB), qui a moins augmenté, la hausse des dépenses serait un peu plus forte.</li>
                <li>Les chiffres tirés de rapports (Cour des comptes, Insee, France Stratégie, Sénat…) sont cités avec leur lien. Un chiffre d'association, de syndicat ou de groupe de réflexion n'est jamais le chiffre de référence : voir la <a href="/methodologie/#chiffres-des-themes">méthodologie</a>.</li>
                <li>Toutes les données de cette page sont téléchargeables, pour refaire les graphiques et les calculs : <a href="/data/dette.json">dette.json</a>.</li>
            </ul>
        </section>

        <Glossaire />
    </div>
</Base>

<style>
    .dette {
        --c1: #2563eb; --c2: #b45309; --c3: #94a3b8; --c4: #0891b2; --grille: color-mix(in srgb, var(--border) 70%, transparent);
        display: grid; grid-template-columns: minmax(0, 1fr); gap: 40px; padding-top: 8px; font-variant-numeric: tabular-nums;
    }
    @media (prefers-color-scheme: dark) { .dette { --c1: #3b82f6; --c2: #c9780a; --c3: #64748b; --c4: #1798b8; } }
    section { display: grid; gap: 16px; }
    .prose { display: grid; gap: 10px; max-width: 70ch; }
    .prose p, .prose li { color: var(--fg-muted); }
    .prose ul { margin: 0; padding-left: 1.2em; display: grid; gap: 8px; }
    .prose strong { color: var(--fg); }
    .muet { color: var(--fg-muted); }
    .petit { font-size: .84rem; }
    a { text-decoration: underline; text-underline-offset: 2px; }
    .etat span { display: inline-block; font-size: .8rem; color: var(--fg-muted); border: 1px solid var(--border); border-radius: 999px; padding: 2px 10px; }

    .cles { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 12px; }
    .tuile { border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; display: grid; gap: 4px; background: var(--bg-soft); }
    .tuile strong { font-size: 1.45rem; line-height: 1.2; }
    .tuile span { font-size: .86rem; color: var(--fg-muted); }

    .figure { margin: 0; border: 1px solid var(--border); border-radius: 10px; padding: 18px; display: grid; gap: 14px; background: var(--bg); min-width: 0; }
    .figure figcaption { display: grid; gap: 2px; }
    .figure figcaption span { font-size: .84rem; color: var(--fg-muted); }
    .legende { font-size: .8rem; color: var(--fg-muted); }
    .note { font-size: .86rem; color: var(--fg-muted); border-left: 3px solid var(--border); padding-left: 10px; }
    .pastille { display: inline-block; width: 10px; height: 10px; border-radius: 3px; flex: none; margin-right: 6px; vertical-align: baseline; }
    .c1.pastille, .seg.c1, .fill.c1 { background: var(--c1); }
    .c2.pastille, .seg.c2, .fill.c2 { background: var(--c2); }
    .c3.pastille, .seg.c3, .fill.c3 { background: var(--c3); }
