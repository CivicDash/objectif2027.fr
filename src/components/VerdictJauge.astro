---
// Jauge de verdict neutre : cinq crans d'une seule couleur, le cran rendu plein, les autres
// en contour. Ni vert ni rouge — la couleur ne dit pas « vrai » ou « faux », et un camp
// ne se retrouve pas en rouge avant qu'on ait lu la fiche. Le libellé est toujours écrit :
// la jauge n'est qu'un repère visuel, masqué aux lecteurs d'écran.
// « Invérifiable » n'est pas un degré d'accord : il a son propre cadre, sans jauge.
import type { CodeVerdict } from '@/lib/data';
import { VERDICTS } from '@/lib/verdicts';

interface Props { verdict: CodeVerdict; portee?: string | null; compact?: boolean }
const { verdict, portee = null, compact = false } = Astro.props;
const def = VERDICTS[verdict];
---
<div class:list={['verdict', compact && 'compact']}>
    {def.cran !== null ? (
        <span class="jauge" aria-hidden="true">
            {[1, 2, 3, 4, 5].map((c) => <span class:list={['cran', c === def.cran && 'plein']} />)}
        </span>
    ) : (
        <span class="sans-mesure" aria-hidden="true">sans mesure</span>
    )}
    <span class="libelle">
        <span class="font-semibold">{def.libelle}</span>
        {portee && <span class="portee"> — {portee}</span>}
    </span>
</div>

<style>
    .verdict { display: flex; align-items: flex-start; gap: 0.75rem; }
    .jauge { display: inline-flex; gap: 3px; flex: none; padding-top: 0.3rem; }
    .cran {
        width: 1.1rem; height: 0.55rem; border-radius: 2px;
        border: 1.5px solid color-mix(in srgb, var(--graphe-fr) 55%, var(--bg));
    }
    .cran.plein { background: var(--graphe-fr); border-color: var(--graphe-fr); }
    .sans-mesure {
        flex: none; font-size: 0.75rem; line-height: 1; padding: 0.25rem 0.4rem; border-radius: 3px;
        border: 1.5px dashed var(--fg-muted); color: var(--fg-muted); margin-top: 0.1rem;
    }
    .libelle { line-height: 1.4; }
    .portee { color: var(--fg-muted); }
    .compact { gap: 0.5rem; font-size: 0.875rem; }
    .compact .cran { width: 0.8rem; height: 0.45rem; }
    @media print { .cran.plein { background: #000; border-color: #000; } .cran { border-color: #000; } }
</style>
