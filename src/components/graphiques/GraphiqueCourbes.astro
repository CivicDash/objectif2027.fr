---
// Courbes temporelles (et indice base 100) : un SVG statique, calculé au build.
// France en couleur d'accent, autres pays en gris, UE-27 en tirets ; étiquettes directes
// en bout de courbe avec la dernière valeur ; point creux pour une valeur provisoire.
import type { Indicateur } from '@/lib/data';
import { nombreFr } from '@/lib/format';
import {
    ORDRE_TRACE, NOMS, axeVertical, decimalesGraduations, echelle, estProvisoire,
    anneesAxe, placerEtiquettes, segments, valeurFr, type Gabarit,
} from '@/lib/graphique';

interface Props {
    indicateur: Indicateur;
    gabarit: Gabarit;
    decimales?: number;
    suffixe?: string;
    yMin?: number;
    classe: string;
    etiquette: string;
}
const { indicateur, gabarit: g, decimales = 1, suffixe = '', yMin = 0, classe, etiquette } = Astro.props;

const series = ORDRE_TRACE
    .filter((p) => indicateur.series[p]?.length)
    .map((p) => ({ pays: p, points: [...indicateur.series[p]].sort((a, b) => a.annee - b.annee) }));

const toutes = series.flatMap((s) => s.points);
const annees = toutes.map((p) => p.annee);
const [a0, a1] = [Math.min(...annees), Math.max(...annees)];
const axe = axeVertical(toutes.map((p) => p.valeur), yMin);
const decAxe = decimalesGraduations(axe.graduations);

const gauche = g.marge.gauche;
const droite = g.largeur - g.marge.droite;
const haut = g.marge.haut;
const bas = g.hauteur - g.marge.bas;
const x = echelle(a0, a1, gauche, droite);
const y = echelle(axe.min, axe.max, bas, haut);

const chemin = (pts: typeof toutes) => pts.map((p, i) => `${i ? 'L' : 'M'}${x(p.annee).toFixed(1)},${y(p.valeur).toFixed(1)}`).join('');

const graduationsX = anneesAxe(a0, a1, g.maxAnnees);

const derniers = series.map((s) => s.points[s.points.length - 1]);
const ysEtiq = placerEtiquettes(derniers.map((d) => y(d.valeur)), g.police * 1.3, haut + g.police / 2, bas);
---
<svg viewBox={`0 0 ${g.largeur} ${g.hauteur}`} class={classe} role="img" aria-label={etiquette}
     font-size={g.police}>
    {axe.graduations.map((v) => (
        <g>
            <line class={v === axe.min ? 'g-base' : 'g-grille'} x1={gauche} x2={droite} y1={y(v)} y2={y(v)} />
            <text x={gauche - 6} y={y(v)} text-anchor="end" dominant-baseline="middle">{nombreFr(v, decAxe)}</text>
        </g>
    ))}
    {graduationsX.map((a) => (
        <text x={x(a)} y={bas + g.police + 6} text-anchor="middle">{a}</text>
    ))}
    {series.map((s) => (
        <g>
            {segments(s.points).map((seg) => seg.length > 1
                ? <path class={`g-ligne pays-${s.pays}`} d={chemin(seg)} />
                : <circle class={`g-ligne pays-${s.pays}`} cx={x(seg[0].annee)} cy={y(seg[0].valeur)} r="1.5" />)}
            {s.points.filter((p) => estProvisoire(p.statut)).map((p) => (
                <circle class={`g-point pays-${s.pays}`} cx={x(p.annee)} cy={y(p.valeur)} r="3.2" />
            ))}
        </g>
    ))}
    {series.map((s, i) => (
        <text x={droite + 8} y={ysEtiq[i]} dominant-baseline="middle" class={`etiq-${s.pays}`}>
            {NOMS[s.pays]} {valeurFr(derniers[i].valeur, decimales, suffixe)}
        </text>
    ))}
</svg>
