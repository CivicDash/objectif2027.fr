---
import { QUESTIONS_ACTIVES, CALENDRIER_ACTIF, QUIZ_ACTIF, JEU_ACTIF, AFFIRMATIONS_ACTIVES } from '@/lib/data';
import '@/styles/global.css';

export interface Props {
    title: string;
    description?: string;
    ogImage?: string;
    ogImageAlt?: string;
    ogType?: string;
    canonical?: string;
    jsonld?: Record<string, unknown> | Record<string, unknown>[];
}

const {
    title,
    description = "Comprendre l'élection présidentielle française de 2027 : candidats, programmes, arguments sourcés. Application citoyenne, neutre, sans compte.",
    ogImage = '/og/default.png',
    ogImageAlt,
    ogType = 'website',
    canonical,
    jsonld,
} = Astro.props;

const url = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const imageAlt = ogImageAlt ?? `${title} — Objectif 2027`;
const structured = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];
const annee = 2027;

// Rubriques regroupées sous « Plus » : dans la barre du bas sur téléphone, dans un menu
// déroulant entre 768 et 1 024 px. Cinq onglets tiennent juste sur 375 px, et neuf entrées
// ne tiennent pas dans le menu du haut avant lg — c'est ce qui rendait « Ce qu'on entend »
// invisible sur mobile et tablette.
const rubriquesPlus = [
    QUESTIONS_ACTIVES && { href: '/questions/', libelle: 'Questions clés' },
    AFFIRMATIONS_ACTIVES && { href: '/ce-qu-on-entend/', libelle: "Ce qu'on entend" },
    JEU_ACTIF && { href: '/jeu/', libelle: 'Qui a dit quoi ?' },
    CALENDRIER_ACTIF && { href: '/calendrier/', libelle: 'Le fil de la campagne' },
    { href: '/demarche/', libelle: 'Démarche' },
].filter(Boolean) as { href: string; libelle: string }[];
const estCourante = (href: string) => Astro.url.pathname.startsWith(href);
const plusCourant = rubriquesPlus.some((r) => estCourante(r.href));
---

<!doctype html>
<html lang="fr">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="author" content="Civis-Consilium" />
        <link rel="canonical" href={url} />
        <meta name="theme-color" content="#1e3a8a" />
        <meta name="robots" content="index, follow, max-image-preview:large" />

        <meta property="og:type" content={ogType} />
        <meta property="og:locale" content="fr_FR" />
        <meta property="og:site_name" content="Objectif 2027" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={url} />
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:secure_url" content={ogImageUrl} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={imageAlt} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageUrl} />
        <meta name="twitter:image:alt" content={imageAlt} />

        {structured.map((obj) => (
            <script type="application/ld+json" set:html={JSON.stringify(obj)} />
        ))}
    </head>
    <body class="min-h-dvh flex flex-col">
        <a href="#contenu" class="skip-link">Aller au contenu</a>

        <header class="border-b" style="border-color: var(--border)">
            <div class="mx-auto max-w-content px-4 h-14 flex items-center justify-between gap-6">
                <a href="/" class="font-bold tracking-tight text-lg shrink-0">Objectif&nbsp;{annee}</a>
                <!-- Navigation desktop uniquement (le mobile utilise la tab bar du bas) -->
                <nav aria-label="Navigation principale" class="hidden md:flex items-center gap-5 lg:gap-7 text-sm font-medium">
                    <a href="/candidats/" class="hover:text-brand-600">Candidats</a>
                    <a href="/comparateur/" class="hover:text-brand-600">Comparateur</a>
                    {QUIZ_ACTIF && <a href="/quiz/" class="hover:text-brand-600">Quiz</a>}
                    <a href="/themes/" class="hover:text-brand-600">Thèmes</a>
                    {/* À partir de lg, tout tient en ligne ; avant, les rubriques secondaires
                        passent dans le menu « Plus » ci-dessous. */}
                    {JEU_ACTIF && <a href="/jeu/" class="hidden lg:inline hover:text-brand-600" title="Qui a dit quoi ?">Jeu</a>}
                    {QUESTIONS_ACTIVES && <a href="/questions/" class="hidden lg:inline hover:text-brand-600" title="Questions clés">Questions</a>}
                    {AFFIRMATIONS_ACTIVES && <a href="/ce-qu-on-entend/" class="hidden lg:inline hover:text-brand-600 whitespace-nowrap">Ce qu'on entend</a>}
                    {CALENDRIER_ACTIF && <a href="/calendrier/" class="hidden lg:inline hover:text-brand-600" title="Le fil de la campagne">Calendrier</a>}
                    <a href="/demarche/" class="hidden lg:inline hover:text-brand-600">Démarche</a>
                    <details class="menu-plus lg:hidden relative" data-menu-plus>
                        <summary class:list={['cursor-pointer inline-flex items-center gap-1 hover:text-brand-600', plusCourant && 'text-brand-600']}>
                            Plus
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                        </summary>
                        <ul class="absolute right-0 top-full mt-3 w-60 rounded-card border py-2 shadow-lg z-30" style="background: var(--bg); border-color: var(--border)">
                            {rubriquesPlus.map((r) => (
                                <li><a href={r.href} aria-current={estCourante(r.href) ? 'page' : undefined} class="block px-4 py-2.5 hover:text-brand-600 aria-[current=page]:text-brand-600 aria-[current=page]:font-semibold">{r.libelle}</a></li>
                            ))}
                        </ul>
                    </details>
                    <a href="/recherche/" aria-label="Recherche" class="hover:text-brand-600 inline-flex items-center" title="Recherche">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
                    </a>
                </nav>
                <!-- Mobile : accès recherche dans la barre du haut (le reste est en tab bar) -->
                <a href="/recherche/" aria-label="Recherche" class="md:hidden inline-flex items-center justify-center tap">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
                </a>
            </div>
        </header>

        <main id="contenu" class="flex-1 w-full mx-auto max-w-content px-4 py-6 pb-24 md:pb-8">
            <slot />
        </main>

        <!-- Tab bar mobile fixe (navigation au pouce) — masquée en desktop -->
        <nav aria-label="Navigation mobile"
             class="md:hidden fixed bottom-0 inset-x-0 z-20 border-t flex"
             style="background: var(--bg); border-color: var(--border); padding-bottom: env(safe-area-inset-bottom)">
            <a href="/candidats/" class="flex-1 flex flex-col items-center gap-0.5 py-2 text-xs" style="min-height:56px">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
                Candidats
            </a>
            <a href="/comparateur/" class="flex-1 flex flex-col items-center gap-0.5 py-2 text-xs" style="min-height:56px">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M9 3v18M15 3v18M3 9h18M3 15h18"/></svg>
                Comparer
            </a>
            {QUIZ_ACTIF && (
                <a href="/quiz/" class="flex-1 flex flex-col items-center gap-0.5 py-2 text-xs" style="min-height:56px">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M9 9a3 3 0 1 1 4 2.8c-.8.4-1 .9-1 1.7M12 17h.01"/><circle cx="12" cy="12" r="9"/></svg>
                    Quiz
                </a>
            )}
            <a href="/themes/" class="flex-1 flex flex-col items-center gap-0.5 py-2 text-xs" style="min-height:56px">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                Thèmes
            </a>
            <details class="menu-plus flex-1" data-menu-plus>
                <summary class:list={['h-full flex flex-col items-center gap-0.5 py-2 text-xs cursor-pointer', plusCourant && 'text-brand-600']} style="min-height:56px">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/></svg>
                    Plus
                </summary>
                <!-- Panneau posé au-dessus de la barre ; la zone de sécurité iOS est comprise. -->
                <ul class="fixed inset-x-0 border-t shadow-lg py-1" aria-label="Plus de rubriques"
                    style="bottom: calc(56px + env(safe-area-inset-bottom)); background: var(--bg); border-color: var(--border)">
                    {rubriquesPlus.map((r) => (
                        <li><a href={r.href} aria-current={estCourante(r.href) ? 'page' : undefined}
                               class="flex items-center px-5 text-base aria-[current=page]:text-brand-600 aria-[current=page]:font-semibold" style="min-height:48px">{r.libelle}</a></li>
                    ))}
                </ul>
            </details>
        </nav>

        <footer class="border-t text-sm" style="border-color: var(--border); color: var(--fg-muted)">
            <div class="mx-auto max-w-content px-4 py-8 space-y-2">
                <p>
                    Données : <strong>CivicDash</strong> / <strong>Civis-Consilium</strong> — sources vérifiées,
                    licence AGPL-3.0.
                </p>
                <p class="flex flex-wrap gap-x-4 gap-y-1">
                    <a href="/recherche/" class="hover:underline">Recherche</a>
                    {JEU_ACTIF && <a href="/jeu/" class="hover:underline">Qui a dit quoi ?</a>}
                    {QUESTIONS_ACTIVES && <a href="/questions/" class="hover:underline">Questions clés</a>}
                    {AFFIRMATIONS_ACTIVES && <a href="/ce-qu-on-entend/" class="hover:underline">Ce qu'on entend</a>}
                    {CALENDRIER_ACTIF && <a href="/calendrier/" class="hover:underline">Le fil de la campagne</a>}
                    <a href="/methodologie/" class="hover:underline">Méthodologie</a>
                    <a href="/mentions-legales/" class="hover:underline">Mentions légales</a>
                    <a href="/data/candidats.json" class="hover:underline">Données ouvertes</a>
                    <a href="https://civis-consilium.eu" class="hover:underline">À propos de l'association</a>
                    <a href="https://civicdash.fr" class="hover:underline">La plateforme CivicDash</a>
                    <a href="/signaler/" class="hover:underline">Signaler une erreur</a>
                </p>
            </div>
        </footer>
        <script>
            for (const menu of document.querySelectorAll<HTMLDetailsElement>('details[data-menu-plus]')) {
                document.addEventListener('click', (e) => {
                    if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
                });
                menu.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape' && menu.open) {
                        menu.open = false;
                        menu.querySelector('summary')?.focus();
                    }
                });
            }
        </script>
    </body>
</html>
